# App Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tool_marketing?schema=public"

# Facebook App Credentials
FB_APP_ID=your_facebook_app_id_here
FB_APP_SECRET=your_facebook_app_secret_here
FB_GRAPH_VERSION=v19.0

# Facebook User / System User Access Token (Marketing API access)
FB_ACCESS_TOKEN=your_facebook_access_token_here

# Facebook Ad Account ID (Format: act_123456789)
FB_AD_ACCOUNT_ID=act_your_ad_account_id_here

# Facebook Page ID & Page Access Token (Messenger / Leads API access)
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Dong A Haus Internal CRM / Order API
DONGA_CRM_API_URL=https://donga-hethong-production.up.railway.app
